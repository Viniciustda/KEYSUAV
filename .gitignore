# 1. Ignorar tudo por padrão
*

# 2. Manter arquivos importantes da raiz
!.gitignore
!README.md
!wscript

# 3. Exceções: Manter os diretórios e arquivos do seu projeto

# Manter todo o conteúdo da pasta de traces
!/flysafe_traces/
!/flysafe_traces/**

# Manter módulo flysafe dentro de src/
!/src/
!/src/flysafe/
!/src/flysafe/**

# Manter os arquivos do core do ns-3 modificados
!/src/network/
!/src/network/model/
!/src/network/model/node.h
!/src/network/model/node.cc

# Manter seu script de simulação em scratch/
!/scratch/
!/scratch/flysafe.cc
!/scratch/drone_image.png
!/scratch/malicious_image.png


# 4. Adicionar os ignores genéricos 
/build/
/.sconsign.lock
*.log

# Arquivos compilados e bibliotecas
*.o
*.so
*.pyc
*.pyo
*.a

# Arquivos de backup de editores
*~
*.swp

# Arquivos de IDEs
.vscode/
.idea/
*.suo
*.user